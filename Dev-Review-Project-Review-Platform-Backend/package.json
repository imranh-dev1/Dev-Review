{
  "name": "dev-review-project-review-platform-backend",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "bun run build && bun run composer:deploy",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:composer": "bun run build && bun run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "start": "node dist/server.mjs",
    "format:check": "npx @biomejs/biome format ./src",
    "format:fix": "npx @biomejs/biome format --write ./src",
    "linter:check": "npx @biomejs/biome lint",
    "linter:fix": "npx @biomejs/biome lint --write ./src"
  },
  "dependencies": {
    "@prisma/composer": "0.28.0",
    "@prisma/composer-prisma-cloud": "0.28.0",
    "@prisma/orm-postgres": "8.0.0-rc.16",
    "alchemy": "2.0.0-beta.78",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "http-status": "^2.1.0",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "prisma": "8.0.0-rc.21",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "effect": "4.0.0-rc.115",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115"
  }
}